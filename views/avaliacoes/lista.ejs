<%- include('../partials/head') %><section class="intro line"><div><span class="eyebrow">Avaliação de jogos</span><h1>Avaliações registradas</h1><p>Consulte os registros realizados.</p></div><a class="button" href="/avaliacoes/nova">Avaliar jogo</a></section><% if (!avaliacoes.length) { %><section class="card empty"><p>Nenhuma avaliação cadastrada.</p><a class="button" href="/avaliacoes/nova">Iniciar avaliação</a></section><% } else { %><section class="card table-wrap"><table><thead><tr><th>Jogo</th><th>Data</th><th></th></tr></thead><tbody><% avaliacoes.forEach(a => { %><tr><td><%= a.jogo %></td><td><%= new Date(a.createdAt).toLocaleString('pt-BR') %></td><td><a href="/avaliacoes/<%= a._id %>">Visualizar</a></td></tr><% }) %></tbody></table></section><% } %><%- include('../partials/footer') %>
