<%- include('../partials/head') %>
    <section class="intro line">
        <div>
            <h1>
                <%= avaliacao.jogo %>
            </h1>
            <p>Avaliação registrada em <%= new Date(avaliacao.createdAt).toLocaleString('pt-BR') %>.</p>
        </div><a class="button" href="/avaliacoes/nova">Avaliar Outro Jogo</a><a class="button" href="/avaliacoes">Ver avaliações realizadas</a>
    </section>
    <section class="card">
        <h2>Escala de avaliação</h2>
        <dl class="answers">
            <% avaliacao.respostasEscala.forEach((r, i)=> { %><div>
                    <dt>
                        <%= i + 1 %>. <%= r.text %>
                    </dt>
                    <dd>
                        <%= r.value %> / 7
                    </dd>
                </div>
                <% }) %>
        </dl>
    </section>
    <section class="card">
        <h2>Questões abertas</h2>
        <h3>Benefícios e vantagens</h3>
        <p class="preserve">
            <%= avaliacao.beneficios %>
        </p>
        <h3>Dificuldades e desvantagens</h3>
        <p class="preserve">
            <%= avaliacao.dificuldades %>
        </p>
        <h3>Sugestões de melhoria</h3>
        <p class="preserve">
            <%= avaliacao.sugestoes %>
        </p>
    </section>
    <% if (avaliacao.bugs) { %>
        <section class="card">
            <h2>Bugs</h2>
            <div class="bug-content"><%- avaliacao.bugs %></div>
        </section>
        <% } %><%- include('../partials/footer') %>