<%- include('../partials/head') %><section class="intro line"><div><span class="eyebrow">Escala SUS</span><h1>Avaliações de usabilidade</h1><p>Resultados.</p></div><a class="button" href="/usabilidade/nova">Aplicar Escala SUS</a></section><% if (!avaliacoes.length) { %><section class="card empty"><p>Nenhuma avaliação SUS cadastrada.</p><a class="button" href="/usabilidade/nova">Iniciar Escala SUS</a></section><% } else { %><section class="card table-wrap"><table><thead><tr><th>Sistema</th><th>Pontuação SUS</th><th>Data</th><th></th></tr></thead><tbody><% avaliacoes.forEach(a => { %><tr><td><%= a.sistema %></td><td><strong><%= a.pontuacaoSUS %> / 100</strong></td><td><%= new Date(a.createdAt).toLocaleString('pt-BR') %></td><td><a href="/usabilidade/<%= a._id %>">Visualizar</a></td></tr><% }) %></tbody></table></section><% } %><%- include('../partials/footer') %>
