<%- include('../partials/head') %><section class="intro line"><div><span class="eyebrow">Avaliações realizadas</span><h1>Avaliações do site <small>Escala SUS</small></h1><p>Consulte as pontuações SUS por site ou pelo e-mail de quem avaliou.</p></div><a class="button secondary-button" href="/avaliacoes-realizadas">Ver tipos de avaliação</a></section><section class="card filter-card"><form method="get" class="filter-form"><label for="email">Filtrar por e-mail</label><select id="email" name="email" onchange="this.form.submit()"><option value="">Todos os e-mails</option><% emails.forEach(item => { %><option value="<%= item %>" <%= email === item ? 'selected' : '' %>><%= item %></option><% }) %></select><noscript><button class="button" type="submit">Filtrar</button></noscript><% if (email) { %><a href="/usabilidade">Limpar filtro</a><% } %></form></section><% if (!avaliacoes.length) { %><section class="card empty"><p>Nenhuma avaliação SUS encontrada<%= email ? ` para ${email}` : '' %>.</p></section><% } else { %><section class="card table-wrap"><table><thead><tr><th>Site</th><th>E-mail</th><th>Pontuação SUS</th><th>Data</th><th></th></tr></thead><tbody><% avaliacoes.forEach(a => { %><tr><td><%= a.sistema %></td><td><%= a.email || 'Não informado' %></td><td><strong><%= a.pontuacaoSUS %> / 100</strong></td><td><%= new Date(a.createdAt).toLocaleString('pt-BR') %></td><td><a href="/usabilidade/<%= a._id %>">Visualizar</a></td></tr><% }) %></tbody></table></section><% } %><%- include('../partials/footer') %>
