<%- include('../partials/head') %>
<section class="intro"><span class="eyebrow">Usabilidade do site</span><h1>Olhar infantil</h1><p>Avalie como crianças encontram, iniciam e usam os jogos no portal.</p></section>
<% if (erro) { %><p class="alert"><%= erro %></p><% } %>
<form action="/usabilidade" method="post">
  <section class="card usability"><h2>Site ou jogo testado</h2><p class="hint">Navegue pelo portal simulando as limitações e o comportamento de uma criança usando mouse e teclado.</p><label for="urlOuNomeJogo">URL ou nome do jogo</label><input id="urlOuNomeJogo" name="urlOuNomeJogo" type="text" maxlength="500" required value="<%= valores.urlOuNomeJogo || 'www.maisludus.com.br' %>" placeholder="Ex.: Jogo da Memória / https://exemplo.com"></section>
  <section class="card usability"><h2>Critérios de usabilidade</h2><% let secaoAtual = ''; questoes.forEach((q) => { if (q.secao !== secaoAtual) { secaoAtual = q.secao; %><h3 class="usability-section"><%= secaoAtual %></h3><% } %><fieldset class="usability-item"><legend><%= q.pergunta %></legend><div class="status-options"><% q.opcoes.forEach(([valor, texto]) => { %><label class="status"><input type="radio" name="item_<%= q.key %>_status" value="<%= valor %>" required <%= valores[`item_${q.key}_status`] === valor ? 'checked' : '' %>><span><%= valor %></span> <%= texto %></label><% }) %></div><label for="item_<%= q.key %>_observacao" class="observacao-label">Observações</label><textarea id="item_<%= q.key %>_observacao" name="item_<%= q.key %>_observacao" placeholder="<%= q.placeholder %>"><%= valores[`item_${q.key}_observacao`] || '' %></textarea></fieldset><% }) %></section>
  <section class="card technical-bugs"><h2>Relatório de bugs técnicos</h2><p class="hint">Descreva travamentos, quebra de layout ou cliques fantasmas encontrados.</p><label for="bugsTecnicos">Bugs técnicos</label><textarea id="bugsTecnicos" name="bugsTecnicos" placeholder="Exemplo: o jogo travou em uma tela preta após clicar em avançar..."><%= valores.bugsTecnicos || '' %></textarea></section>
  <button class="button" type="submit">Salvar avaliação de usabilidade</button>
</form>
<%- include('../partials/footer') %>
