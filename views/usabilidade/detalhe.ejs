<%- include('../partials/head') %><section class="intro line"><div><span class="eyebrow">Escala SUS</span><h1>Avaliação de usabilidade</h1><p>Registrada em <%= new Date(avaliacao.createdAt).toLocaleString('pt-BR') %>.</p></div><a class="button" href="/usabilidade">Voltar à lista</a></section><section class="card sus-score"><p class="eyebrow">Pontuação SUS</p><strong><%= avaliacao.pontuacaoSUS %></strong><span>/ 100</span><h2><%= avaliacao.sistema %></h2></section><section class="card sus-card"><h2>Respostas</h2><dl class="answers"><% avaliacao.respostas.forEach((resposta) => { %><div><dt><span class="question-number"><%= resposta.numero %></span><%= resposta.texto %></dt><dd><%= resposta.valor %> / 5</dd></div><% }) %></dl></section><% if (avaliacao.observacoes) { %><section class="card"><h2>Observações adicionais</h2><p class="preserve"><%= avaliacao.observacoes %></p></section><% } %><%- include('../partials/footer') %>
