<%- include('../partials/head') %>
<section class="intro"><span class="eyebrow">Escala SUS</span><h1>Avaliação de usabilidade</h1><p>System Usability Scale em português: responda de acordo com sua experiência de uso do sistema.</p></section>
<% if (erro) { %><p class="alert"><%= erro %></p><% } %>
<form action="/usabilidade" method="post">
  <section class="card sus-intro"><h2>Sistema avaliado</h2><label for="sistema">URL, nome do jogo ou site</label><input id="sistema" name="sistema" type="text" maxlength="500" required value="<%= valores.sistema || 'maisludus.com.br' %>" placeholder="Ex.: Jogo da Memória / https://exemplo.com"></section>
  <section class="card sus-card"><h2>Questionário SUS</h2><p class="hint">Use a escala de 1 a 5: 1 = Discordo totalmente · 2 = Discordo · 3 = Nem concordo nem discordo · 4 = Concordo · 5 = Concordo totalmente.</p><% itensSUS.forEach((texto, indice) => { const numero = indice + 1; %><fieldset class="sus-item"><legend><span class="question-number"><%= numero %></span><%= texto %></legend><div class="sus-scale" role="radiogroup" aria-label="Item <%= numero %>"><% for (let valor = 1; valor <= 5; valor++) { %><label><input type="radio" name="sus_<%= numero %>" value="<%= valor %>" required <%= String(valores[`sus_${numero}`]) === String(valor) ? 'checked' : '' %>><span><%= valor %></span></label><% } %></div></fieldset><% }) %></section>
  <section class="card"><h2>Observações adicionais</h2><label for="observacoes">Conte algo que tenha facilitado ou dificultado o uso (opcional)</label><textarea id="observacoes" name="observacoes" placeholder="Registre observações sobre a experiência..."><%= valores.observacoes || '' %></textarea></section>
  <button class="button" type="submit">Salvar Escala SUS</button>
</form>
<%- include('../partials/footer') %>
