<%- include('../partials/head') %><section class="intro line"><div><span class="eyebrow">Usabilidade do site</span><h1>Avaliações registradas</h1><p>Registros independentes da avaliação dos jogos.</p></div><a class="button" href="/usabilidade/nova">Avaliar site</a></section><% if (!avaliacoes.length) { %><section class="card empty"><p>Nenhuma avaliação de usabilidade cadastrada.</p><a class="button" href="/usabilidade/nova">Iniciar avaliação</a></section><% } else { %><section class="card table-wrap"><table><thead><tr><th>Site ou jogo</th><th>Data</th><th></th></tr></thead><tbody><% avaliacoes.forEach(a => { %><tr><td><%= a.urlOuNomeJogo %></td><td><%= new Date(a.createdAt).toLocaleString('pt-BR') %></td><td><a href="/usabilidade/<%= a._id %>">Visualizar</a></td></tr><% }) %></tbody></table></section><% } %><%- include('../partials/footer') %>
