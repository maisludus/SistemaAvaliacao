<%- include('../partials/head') %><section class="intro line"><div><span class="eyebrow">Usabilidade do site</span><h1>Avaliação registrada</h1><p>Registrada em <%= new Date(avaliacao.createdAt).toLocaleString('pt-BR') %>.</p></div><a class="button" href="/usabilidade">Voltar à lista</a></section><section class="card usability"><h2><%= avaliacao.urlOuNomeJogo %></h2><% let secaoAtual = ''; avaliacao.respostas.forEach((r) => { if (r.secao !== secaoAtual) { secaoAtual = r.secao; %><h3 class="usability-section"><%= secaoAtual %></h3><% } %><div class="usability-result"><p><strong><%= r.pergunta %></strong></p><p><span class="badge"><%= r.status %></span></p><% if (r.observacao) { %><p class="preserve"><%= r.observacao %></p><% } %></div><% }) %></section><% if (avaliacao.bugsTecnicos) { %><section class="card technical-bugs"><h2>Relatório de bugs técnicos</h2><p class="preserve"><%= avaliacao.bugsTecnicos %></p></section><% } %><%- include('../partials/footer') %>
